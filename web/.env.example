# חיבור למסד הנתונים. ב-Neon: DATABASE_URL = כתובת Pooled, DIRECT_URL = כתובת Direct
# בפיתוח מקומי שתיהן יכולות להיות אותה כתובת
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/galshanim"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/galshanim"

# מחרוזת אקראית ארוכה (32 תווים לפחות) לחתימת ההתחברות
SESSION_SECRET="long-random-string"

# משתמש המנהלת שנוצר בהרצה הראשונה של ה-seed
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# 1 = ליצור גם מוצרים, לקוחות ועובד לדוגמה (רק בהרצה הראשונה)
SEED_DEMO="0"
