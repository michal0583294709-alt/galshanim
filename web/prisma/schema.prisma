// מודל הנתונים לפי docs/ERD.pdf
// תוספת: Provider (ספקים שהמנהלת מוסיפה מתוך המערכת), Customer.is_active (ארכוב לקוח עם הזמנות)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  admin
  employee
}

enum CustomerType {
  surf_shop
  surf_school
  club
  hotel
  other
}

enum OrderStatus {
  new
  processing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  credit_card
  bank_transfer
  net_terms
}

enum PaymentStatus {
  pending
  paid
  on_terms
}

enum ProviderType {
  payment
  invoicing
  shipping
}

model StaffUser {
  id            String    @id @default(cuid())
  full_name     String
  email         String    @unique
  password_hash String
  role          StaffRole @default(employee)
  permissions   Json?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model Customer {
  id                    String        @id @default(cuid())
  business_name         String
  business_tax_id       String
  contact_name          String
  email                 String        @unique
  phone                 String?
  password_hash         String
  customer_type         CustomerType?
  address               String?
  is_net_terms_approved Boolean       @default(false)
  net_terms_days        Int?
  is_active             Boolean       @default(true)
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
  orders                Order[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String?
  price       Decimal          @db.Decimal(12, 2)
  is_active   Boolean          @default(true)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  variants    ProductVariant[]
  images      ProductImage[]
}

model ProductVariant {
  id             String      @id @default(cuid())
  product_id     String
  product        Product     @relation(fields: [product_id], references: [id], onDelete: Restrict)
  size           String
  color          String
  material       String?
  stock_quantity Int         @default(0)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  order_items    OrderItem[]

  @@index([product_id])
}

model ProductImage {
  id         String   @id @default(cuid())
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  color      String
  image_url  String
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([product_id, color])
}

model Order {
  id                String        @id @default(cuid())
  customer_id       String
  customer          Customer      @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  order_number      String        @unique
  status            OrderStatus   @default(new)
  payment_method    PaymentMethod
  payment_status    PaymentStatus @default(pending)
  payment_due_date  DateTime?     @db.Date
  subtotal_amount   Decimal       @db.Decimal(12, 2)
  shipping_fee      Decimal       @db.Decimal(12, 2)
  total_amount      Decimal       @db.Decimal(12, 2)
  shipping_address  String
  shipping_carrier  String?
  tracking_number   String?
  shipped_at        DateTime?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  items             OrderItem[]
  invoice           Invoice?

  @@index([customer_id])
  @@index([status])
  @@index([created_at])
}

model OrderItem {
  id                 String         @id @default(cuid())
  order_id           String
  order              Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_variant_id String
  product_variant    ProductVariant @relation(fields: [product_variant_id], references: [id], onDelete: Restrict)
  quantity           Int
  unit_price         Decimal        @db.Decimal(12, 2)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  @@index([order_id])
  @@index([product_variant_id])
}

model Invoice {
  id             String   @id @default(cuid())
  order_id       String   @unique
  order          Order    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  invoice_number String   @unique
  amount         Decimal  @db.Decimal(12, 2)
  issued_at      DateTime @default(now())
  document_url   String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model Provider {
  id         String       @id @default(cuid())
  type       ProviderType
  name       String
  website    String?
  notes      String?
  is_active  Boolean      @default(true)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  @@index([type])
}
